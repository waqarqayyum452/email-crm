# Copy to .env and fill privately. Never commit .env or share its values in chat.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Blank: APP_URL origin only. Use * to allow any HTTP(S) API origin, or a
# comma-separated list such as https://crm.example.com,http://localhost:3000.
# Cross-origin cookie sharing is disabled; keep the dashboard and API together.
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0

# MySQL 8+ or MariaDB 10.11+; use the hPanel-provided DB host/user in hosting.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=email_crm
DB_USER=email_crm
DB_PASSWORD=
# Optional strict TLS for a remote MySQL server. Never disable verification.
DB_SSL=false
# Optional PEM CA certificate value (use escaped \n for newlines if needed).
DB_SSL_CA=
# Local Docker database only; not used by the application.
DB_ROOT_PASSWORD=
# Optional compatibility Docker service; set DB_PORT=3307 when using it.
MARIADB_PORT=3307

# Generate each independently using the README commands. Do not reuse keys.
# Exactly 32 random bytes encoded as base64. Keep with encrypted backups.
ENCRYPTION_KEY=
SCHEDULER_SECRET=
# Server origin for the optional HTTP scheduler runner. Use your HTTPS CRM
# origin in hosting. Next.js serves the dashboard and API on one local origin.
SCHEDULER_BASE_URL=http://localhost:3000

# No public signup. Bootstrap prompts privately when OWNER_PASSWORD is absent.
OWNER_EMAIL=info@sandiegowebsiteexperts.com
OWNER_NAME=Agency Owner
OWNER_PASSWORD=

# Fail-closed sending gate. Also paused in dashboard defaults.
# Enable only after separate explicit authorization for real sending.
LIVE_SEND_ENABLED=false

# Diagnostics only; mailbox credentials are entered privately in Settings.
DOCTOR_SMTP_HOST=smtp.hostinger.com
DOCTOR_SMTP_PORT=465
DOCTOR_IMAP_HOST=imap.hostinger.com
DOCTOR_IMAP_PORT=993
# Optional: check the local running server, without authentication.
DOCTOR_CHECK_HTTP=false
