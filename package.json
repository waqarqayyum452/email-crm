{
  "name": "sdwe-email-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "npm run typecheck && next build --webpack && npm run build:tools",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:rollback": "tsx scripts/migrate.ts rollback",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "worker:once": "tsx scripts/worker.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "test:integration": "vitest run integration",
    "test:browser": "node tests/browser-check.mjs",
    "build:tools": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.5.0",
    "imapflow": "^1.0.195",
    "ipaddr.js": "^2.2.0",
    "knex": "^3.1.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.1",
    "mailparser": "^3.7.3",
    "mysql2": "^3.14.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.6.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.15.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
