  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "outDir": "dist", "rootDir": ".", "sourceMap": true
  },
  "include": ["server", "scripts"], "exclude": ["node_modules", "dist"]
}
